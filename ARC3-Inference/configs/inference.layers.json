{
  "shared": {
    "model_name": "vrfai/Qwen3.6-27B-FP8",
    "base_url": "http://127.0.0.1:1234/v1",
    "provider": "vllm",
    "context_window": 32768
  },
  "experiments": {
    "root_dir": "/shared/arc_3_results/{username}"
  },
  "environment": {
    "dataset": "",
    "include_tags": ["official"],
    "exclude_tags": [],
    "games": [],
    "max_steps": null,
    "max_runtime_minutes": 45,
    "max_experiment_runtime_minutes": null,
    "max_experiment_runtime_hours": null,
    "n_passes": 20,
    "concurrent_jobs": 32
  },
  "deployment": {
    "target": "inline",
    "wait": false,
    "source_repos": ["../tufa-arc-agi-framework"],
    "slurm": {
      "gpu": "B200",
      "gpu_count": 2,
      "time": "13:00:00",
      "image": "",
      "partition": "gpu",
      "nodelist": "",
      "start_local_server": true,
      "extra_sbatch_flags": ["--account=default", "--qos=normal"]
    }
  },
  "server" : {
    "backend": "vllm",
    "host": "127.0.0.1",
    "port": 1234,
    "tensor_parallel_size": 1,
    "dtype": "auto",
    "gpu_memory_utilization": 0.92,
    "trust_remote_code": true,
    "generation_config": "vllm",
    "language_model_only": false,
    "enable_prefix_caching": true,
    "tool_call_parser": "qwen3_coder",
    "reasoning_parser": "qwen3",
    "default_chat_template_kwargs": {
      "preserve_thinking": true
    }
  },
  "analyzer": {
    "app_name": "ARC3 Agent Harness",
    "max_output": 0,
    "thinking": true,
    "temperature": 0.6,
    "top_p": 0.95,
    "top_k": 20,
    "timeout": 120,
    "tool_steps": 0,
    "tool_timeout": 30,
    "tool_output_tokens": 1024,
    "save_request_logs": false,
    "prediction_check": {
      "enabled": true,
      "max_wrong_diffs_shown": 5,
      "sandbox_log_size": 20,
      "nudge_after_actions": 5,
      "auto_predict": true,
      "hud_change_fraction": 0.8,
      "max_surprises_shown": 3
    },
    "level_review": {
      "enabled": true,
      "llm_review": true,
      "max_review_tokens": 2048,
      "max_llm_calls_per_level": 1,
      "review_thinking": false,
      "llm_timeout_seconds": 60,
      "review_time_budget_seconds": 90,
      "max_facts_in_context": 15,
      "max_refuted_in_context": 5,
      "max_block_chars": 2500,
      "min_support": 2,
      "perturbation_test": true,
      "check_timeout_seconds": 10,
      "quick_check_seconds": 3,
      "max_review_transitions": 300,
      "max_hypotheses": 60
    }
  },
  "chat": {
    "max_tokens": 2048,
    "temperature": 0.7,
    "top_p": 0.8,
    "top_k": 20,
    "thinking": true
  },
  "viewer": {
    "port": 8021
  },
  "multimodal" : {
    "context" : "current_grid",
    "upscale" : 4
  }
}
